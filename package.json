{
	"name": "device-unique-keygen",
	"version": "0.3.0",
	"description": "Generate a compact, deterministic browser identifier from local browser signals",
	"main": "./lib/index.js",
	"module": "./lib/index.mjs",
	"types": "./lib/index.d.ts",
	"exports": {
		".": {
			"types": "./lib/index.d.ts",
			"import": "./lib/index.mjs",
			"require": "./lib/index.js",
			"default": "./lib/index.mjs"
		},
		"./global": "./lib/index.global.js"
	},
	"private": false,
	"scripts": {
		"build:types": "tsc --emitDeclarationOnly --declaration --outDir lib --declarationMap false",
		"build:bundle": "tsup src/index.ts --format esm,cjs,iife --global-name DeviceKeygen --out-dir lib --minify --clean --silent",
		"build": "npm run build:bundle && npm run build:types",
		"build:npm": "npm run build:bundle && npm run build:types",
		"test": "vitest run",
		"test:package": "node tests/package-exports.mjs",
		"test:browser": "playwright test",
		"check": "npm run test && npm run build && npm run test:package && npm pack --dry-run",
		"prepublishOnly": "npm run test && npm run build"
	},
	"publishConfig": {
		"registry": "https://registry.npmjs.org/"
	},
	"keywords": [
		"device-keygen",
		"device-key",
		"device-id",
		"browserfingerprint",
		"fingerprinting",
		"jsfingerprint",
		"uniquebrowserid",
		"nodejs",
		"cryptography",
		"fraud-detection",
		"canvas-fingerprinting",
		"audio-fingerprinting",
		"visitor-identifier",
		"identification",
		"reactjs",
		"javascript",
		"typescript"
	],
	"author": "Yash Joshi",
	"license": "MIT",
	"sideEffects": false,
	"engines": {
		"node": ">=18"
	},
	"bugs": {
		"url": "https://github.com/yashjk/device-keygen/issues"
	},
	"homepage": "https://github.com/yashjk/device-keygen#readme",
	"files": [
		"lib",
		"LICENSE",
		"README.MD"
	],
	"devDependencies": {
		"@playwright/test": "^1.63.0",
		"tsup": "^8.5.0",
		"typescript": "^5.4.0",
		"vitest": "^5.0.0"
	},
	"directories": {
		"doc": "docs",
		"example": "example",
		"lib": "lib"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/yashjk/device-keygen.git"
	}
}
